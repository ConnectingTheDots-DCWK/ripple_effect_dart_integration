/out/
.dart_tool/
/build/
pubspec.lock
!/example/flame_player/pubspec.lock
.idea/
.vscode/*
*.swp

# The web backend's engine files, generated by tool/web and published:
# .pubignore deliberately does not name them. The folders themselves are
# committed, a .gitkeep each, because the pubspec declares them as assets and
# Flutter and the analyzer both complain of a folder that is not there.
# Named by kind rather than by folder with a re-include, which pub's own
# reading of this file does not honour.
/lib/src/web/engine/NOTICE
/lib/src/web/engine/*.js
/lib/src/web/engine/*/*.js
/lib/src/web/engine/*/*.wasm
/tool/web/node_modules/
